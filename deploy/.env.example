# ============================================================================
# RODO MOTO MANDADOS · CONFIGURACIÓN DE PRODUCCIÓN (HOSTINGER VPS)
# - Reutiliza tu contenedor PostgreSQL 16 existente (rodo-db-1) sin duplicarlo
# - NO usa los puertos 80 ni 443 (expone la app en WEB_PORT, por defecto 8080)
# ============================================================================

# 1. Puerto HTTP libre en el VPS (apunta tu proxy principal 80/443 a 127.0.0.1:8080)
WEB_PORT=8080

# 2. Contenedor PostgreSQL 16 EXISTENTE en tu VPS Hostinger
# (El script deploy-hostinger.sh detecta la red y crea el usuario/BD automáticamente)
POSTGRES_CONTAINER=rodo-db-1
POSTGRES_HOST=rodo-db-1
POSTGRES_PORT=5432
POSTGRES_NETWORK=rodo_default
POSTGRES_USER=rodo_user
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_SEGURA_2026
POSTGRES_DB=rodo_db

# 3. Seguridad JWT, CORS y Administrador Maestro (Contenedor rodo-api)
NODE_ENV=production
JWT_SECRET=CAMBIA_ESTE_SECRETO_JWT_DE_MINIMO_32_CARACTERES
ADMIN_EMAIL=edsoncruz14999@gmail.com
ADMIN_INITIAL_PASSWORD=CAMBIA_ESTA_CLAVE_ADMIN_SEGURA
# En producción restringe a tu dominio (se admiten varios separados por coma, o * para pruebas)
CORS_ORIGIN=https://rodomotomandados.com,https://www.rodomotomandados.com

# 4. Retención de respaldos automáticos diarios de PostgreSQL
BACKUP_KEEP_DAYS=14
