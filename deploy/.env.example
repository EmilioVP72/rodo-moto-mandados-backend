# ============================================================================
# RODO MOTO MANDADOS · CONFIGURACIÓN DE ENTORNO (DOCKER / VPS HOSTINGER)
# ============================================================================

# 1. Dominio público apuntado al VPS (Usado por Caddy para SSL Let's Encrypt automático)
# En pruebas locales usa: localhost
# En VPS Hostinger usa tu dominio real, ej: rodomotomandados.com
DOMAIN=localhost

# 2. Base de Datos PostgreSQL 16 (Contenedor rodo-db)
POSTGRES_USER=rodo_user
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_SEGURA_2026
POSTGRES_DB=rodo_db

# 3. Seguridad JWT y Administrador Maestro (Contenedor rodo-api)
NODE_ENV=production
JWT_SECRET=CAMBIA_ESTE_SECRETO_JWT_DE_MINIMO_32_CARACTERES
ADMIN_EMAIL=edsoncruz14999@gmail.com
ADMIN_INITIAL_PASSWORD=RODO2026
CORS_ORIGIN=*

# 4. Puerto HTTP en ambiente local (docker-compose.yml) y retención de respaldos
WEB_PORT=8080
BACKUP_KEEP_DAYS=14
