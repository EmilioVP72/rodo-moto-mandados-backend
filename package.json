{
  "name": "rodo-backend-api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API & Real-Time Dispatch Server for RODO Moto Mandados (Fastify + Prisma + PostgreSQL + Redis + Socket.IO)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --experimental-strip-types --test tests/domainRules.test.ts tests/ineCrypto.test.ts tests/migrationPlan.test.mjs tests/*.regression.test.mjs",
    "test:e2e": "node --experimental-strip-types --test tests/e2eIntegration.test.ts",
    "db:generate": "prisma generate",
    "db:deploy": "node prisma/deploy.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^8.0.2",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.6.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/nodemailer": "^8.0.2"
  }
}
